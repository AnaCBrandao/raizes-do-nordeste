                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Pagamento aprovado', function () { pm.expect(json.statusPagamento).to.eql('APROVADO'); });",
                  "pm.test('Pedido atualizado para EM_PREPARO', function () { pm.expect(json.statusPedidoAtualizado).to.eql('EM_PREPARO'); });",
                  "pm.test('Transação mock gerada', function () { pm.expect(json.transacaoId).to.match(/^PAG-MOCK-/); });"
                ]
              }
            }
          ]
        },
