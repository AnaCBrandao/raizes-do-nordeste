                "{{pedidoCriadoId}}",
                "status"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Status anterior é EM_PREPARO', function () { pm.expect(json.statusAnterior).to.eql('EM_PREPARO'); });",
                  "pm.test('Novo status é PRONTO', function () { pm.expect(json.novoStatus).to.eql('PRONTO'); });",
                  "pm.test('Pedido correto foi atualizado', function () { pm.expect(json.pedidoId).to.eql(Number(pm.collectionVariables.get('pedidoCriadoId'))); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}